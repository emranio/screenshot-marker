# ---------------------------------------------------------------------------
# Provider: which vision backend to use. One of: codex, gemini, claude
# ---------------------------------------------------------------------------
MARKER_PROVIDER=codex

# Auth mode (applies to whichever provider is selected):
#   auth -> the provider's native credentials (no API key)
#             codex  : a local `codex login` (ChatGPT/Codex subscription)
#             gemini : Vertex AI via `gcloud auth application-default login`
#             claude : ANTHROPIC_AUTH_TOKEN / CLAUDE_CODE_OAUTH_TOKEN, or a
#                      `claude` / `ant` login
#   api  -> an explicit API key (see per-provider keys below)
# Leave unset to use the provider default (codex->auth, gemini->api, claude->api).
# (The legacy value MARKER_AUTH=codex still works and means "auth".)
MARKER_AUTH=auth

# ---------------------------------------------------------------------------
# Codex / OpenAI provider
# ---------------------------------------------------------------------------
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
# Only needed when MARKER_AUTH=api (either variable works):
# CODEX_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Gemini provider (Google Gen AI SDK)
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-pro
# Used when MARKER_AUTH=api (either variable works):
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# Used when MARKER_AUTH=auth (Vertex AI via Application Default Credentials):
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Claude provider (Anthropic SDK)
# ---------------------------------------------------------------------------
CLAUDE_MODEL=claude-opus-4-8
# Used when MARKER_AUTH=api (either variable works):
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=sk-ant-...
# Used when MARKER_AUTH=auth (Claude subscription bearer token; either works):
# ANTHROPIC_AUTH_TOKEN=...
# CLAUDE_CODE_OAUTH_TOKEN=...
